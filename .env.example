# Copy this file to `.env` (same folder) and fill in your values.
# `.env` is git-ignored. Never commit it or paste its contents anywhere.

# ESPN private league (see README > "Getting your ESPN cookies")
ESPN_LEAGUE_ID=
# espn-api names a season by the year it ENDS: 2026-27 season = 2027
ESPN_SEASON=2027
ESPN_S2=
ESPN_SWID=
# Optional: your ESPN team id. If blank, the job matches your SWID to the team owner.
ESPN_TEAM_ID=
